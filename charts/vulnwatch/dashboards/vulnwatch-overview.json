      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(vulnwatch_findings_open_public_exploit{job=~\"$job\",tenant=~\"$tenant\"})",
          "refId": "A",
