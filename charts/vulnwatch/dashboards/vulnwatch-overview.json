{
  "title": "vulnwatch · overview",
  "uid": "vulnwatch-overview",
  "tags": [
    "security",
    "vulnwatch"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "timezone": "",
  "description": "Every tenant at a glance: open findings per tenant environment, vulnerabilities shared by several tenants, and what was discovered when. vulnwatch · tenant shows one tenant in detail.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(vulnwatch_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(vulnwatch_build_info, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "sort": 1
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(vulnwatch_tenant_info{job=~\"$job\"}, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(vulnwatch_tenant_info{job=~\"$job\"}, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "sort": 1
      },
      {
        "name": "priority",
        "label": "Priority",
        "type": "custom",
        "query": "P1,P2,P3,P4",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "vulnwatch · tenant",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/vulnwatch/vulnwatch",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "All tenants",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Tenant environments",
      "description": "Tenant environments watched (the local stack included).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(vulnwatch_tenant_info{job=~\"$job\",tenant=~\"$tenant\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
