      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Since last successful run",
      "description": "Time since the last fully successful run. vulnwatch runs once a day.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(vulnwatch_last_success_timestamp_seconds{job=~\"$job\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          },
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Tenants",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "description": "One row per tenant environment: open findings by priority, exploited (KEV) ones, the days since vulnwatch first saw the oldest open finding, what the last run found, how long ago the last successful run was (one run covers every tenant), and the inventory age: days since stack discover or merge read the environment's cluster (generated_at in stack.yaml; – without one). Click a tenant for its dashboard.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_join(count by (tenant, environment) (vulnwatch_product_info{job=~\"$job\",tenant=~\"$tenant\"}), \"key\", \"/\", \"tenant\", \"environment\")",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_open{job=~\"$job\",tenant=~\"$tenant\",priority=\"P1\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_open{job=~\"$job\",tenant=~\"$tenant\",priority=\"P2\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_open{job=~\"$job\",tenant=~\"$tenant\",priority=\"P3\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_open{job=~\"$job\",tenant=~\"$tenant\",priority=\"P4\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_open_kev{job=~\"$job\",tenant=~\"$tenant\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "F",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(max by (tenant, environment) (vulnwatch_findings_open_oldest_days{job=~\"$job\",tenant=~\"$tenant\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "G",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(sum by (tenant, environment) (vulnwatch_findings_new{job=~\"$job\",tenant=~\"$tenant\"}), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "H",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(time() - max by (tenant, environment) (vulnwatch_tenant_info{job=~\"$job\",tenant=~\"$tenant\"} * on (job) group_left () max by (job) (vulnwatch_last_success_timestamp_seconds{job=~\"$job\"})), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "I",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (key) (label_join(floor((time() - max by (tenant, environment) (vulnwatch_tenant_inventory_timestamp_seconds{job=~\"$job\",tenant=~\"$tenant\"})) / 86400), \"key\", \"/\", \"tenant\", \"environment\"))",
          "refId": "J",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "tenant",
                "environment",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #A",
                "Value #I",
                "Value #J"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "tenant": 0,
              "environment": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #A": 9,
              "Value #I": 10,
              "Value #J": 11
            },
            "renameByName": {
              "tenant": "Tenant",
              "environment": "Environment",
              "Value #A": "Products",
              "Value #B": "P1",
              "Value #C": "P2",
              "Value #D": "P3",
              "Value #E": "P4",
              "Value #F": "KEV",
              "Value #G": "Days since first seen",
              "Value #H": "New (last run)",
              "Value #I": "Last run",
              "Value #J": "Inventory age"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "P1",
                "desc": true
              },
              {
                "field": "KEV",
                "desc": true
              },
              {
                "field": "P2",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
