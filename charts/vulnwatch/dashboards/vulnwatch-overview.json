      }
    },
    {
      "type": "stat",
      "title": "New in last run",
      "description": "Findings reported in the last run (new or materially changed), across all tenants.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
