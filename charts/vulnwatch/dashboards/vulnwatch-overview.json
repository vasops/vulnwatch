            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tenant"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the tenant's dashboard",
                    "url": "/d/vulnwatch/vulnwatch?var-tenant=${__data.fields.tenant}&var-environment=${__data.fields.environment}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P1"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
