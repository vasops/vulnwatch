{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "vulnwatch chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "string",
      "minLength": 9
    },
    "timeZone": {
      "type": "string"
    },
    "suspend": {
      "type": "boolean"
    },
    "startingDeadlineSeconds": {
      "type": "integer",
      "minimum": 10
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "ttlSecondsAfterFinished": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "run": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "enum": [
              "stdout",
              "json",
              "html",
              "slack"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "audit",
            "warn",
            "error"
          ],
          "description": "audit: what was reported and sent (findings with priority, Slack messages, state written), plus warnings and errors."
        },
        "logFormat": {
          "enum": [
            "json",
            "text"
          ]
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "outputs": {
          "type": "array",
          "items": {
            "enum": [
              "stdout",
              "json",
              "html",
              "slack"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "news": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "enum": [
              "stdout",
              "slack"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "repost": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$",
          "description": "Name of the local (top-level) stack in reports, metrics and dashboards; default local."
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$",
          "description": "Environment of the local stack; default default."
        },
        "generated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "When stack discover or merge read the local stack from its cluster (YYYY-MM-DD, UTC)."
        },
        "defaults": {
          "type": "object"
        },
        "products": {
          "type": "object"
        },
        "helm": {
          "type": "array"
        },
        "os": {
          "type": "object",
          "description": "The nodes' OS; the kernel is watched as <name>-<release>-kernel, e.g. debian-13-kernel.",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "debian",
                "ubuntu",
                "rhel",
                "rocky",
                "almalinux",
                "sles",
                "opensuse-leap"
              ]
            },
            "release": {
              "type": "string"
            },
            "kernel": {
              "type": "string"
            },
            "kernel_package": {
              "type": "string"
            },
            "exposure": {
              "type": "string",
              "enum": [
                "internet",
                "internal"
              ]
            },
            "criticality": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "min_cvss": {
              "type": "number"
            }
          },
          "required": [
            "name",
            "release",
            "kernel"
          ],
          "additionalProperties": false
        },
        "tenants": {
          "type": "object",
          "description": "Other stacks watched from here (customers, organizations, teams), per environment.",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "defaults": {
                "type": "object"
              },
              "slack": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string"
                  },
                  "alert_channel": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "description": "Slack channel IDs for this tenant's run summary and P1 alerts (alert_channel defaults to channel); without them the default channels are used."
              },
              "environments": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "generated_at": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                      "description": "When stack discover or merge read this environment's stack from its cluster (YYYY-MM-DD, UTC)."
                    },
                    "defaults": {
                      "type": "object"
                    },
                    "slack": {
                      "type": "object",
                      "properties": {
                        "channel": {
                          "type": "string"
                        },
                        "alert_channel": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false,
                      "description": "Slack channel IDs for this tenant's run summary and P1 alerts (alert_channel defaults to channel); without them the default channels are used."
                    },
                    "products": {
                      "type": "object"
                    },
                    "helm": {
                      "type": "array"
                    },
                    "os": {
                      "type": "object",
                      "description": "The nodes' OS; the kernel is watched as <name>-<release>-kernel, e.g. debian-13-kernel.",
                      "properties": {
                        "name": {
                          "type": "string",
                          "enum": [
                            "debian",
                            "ubuntu",
                            "rhel",
                            "rocky",
                            "almalinux",
                            "sles",
                            "opensuse-leap"
                          ]
                        },
                        "release": {
                          "type": "string"
                        },
                        "kernel": {
                          "type": "string"
                        },
                        "kernel_package": {
                          "type": "string"
                        },
                        "exposure": {
                          "type": "string",
                          "enum": [
                            "internet",
                            "internal"
                          ]
                        },
                        "criticality": {
                          "type": "string",
                          "enum": [
                            "high",
                            "medium",
                            "low"
                          ]
                        },
                        "min_cvss": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "name",
                        "release",
                        "kernel"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "minProperties": 1
              }
            },
            "required": [
              "environments"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "configOverride": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object"
        },
        "run": {
          "type": "object"
        },
        "triage": {
          "type": "object"
        },
        "outputs": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        },
        "product_defaults": {
          "type": "object"
        },
        "version": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "sourcesOverride": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "object"
        },
        "catalog": {
          "type": "object"
        },
        "helm_charts": {
          "type": "object"
        },
        "version": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "trivy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tmpDir": {
      "type": "object",
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "pushgateway": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(|https?://.+)$"
            },
            "job": {
              "type": "string",
              "minLength": 1
            },
            "grouping": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "url": {
              "type": "string",
              "pattern": "^(|https?://.+)$"
            }
          },
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "maxRunAgeHours": {
              "type": "integer",
              "minimum": 1
            },
            "inventoryMaxAgeDays": {
              "type": "integer",
              "minimum": 1,
              "description": "VulnwatchInventoryStale fires when a stack's generated_at is older than this."
            },
            "sourceFailingFor": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$"
            },
            "findingAlerts": {
              "type": "boolean"
            },
            "extraRules": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "runtimeClassName": {
      "type": "string",
      "description": "e.g. gvisor or kata"
    },
    "landlock": {
      "enum": [
        "require",
        "true",
        "false",
        true,
        false
      ],
      "description": "VULNWATCH_LANDLOCK: require fails the run without Landlock, true runs unrestricted then, false turns it off"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "internetExcept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pinDNS": {
          "type": "boolean"
        },
        "dnsPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "pushgatewayPort": {
          "type": "integer",
          "minimum": 1
        },
        "pushgatewayNamespace": {
          "type": "string"
        },
        "pushgatewayPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "apiServerPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "extraEgress": {
          "type": "array"
        },
        "cilium": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fqdns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "extraFQDNs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dnsSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object"
    },
    "existingStackConfigMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secretEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "envFromSecrets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "envFrom": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "required": [
    "image",
    "schedule",
    "persistence",
    "metrics"
  ]
}
