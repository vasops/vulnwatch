{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Go module patch updates in one pull request",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "go module patch updates"
    },
    {
      "description": "The Go toolchain: go.mod, the CI image and the Dockerfile together. Not pins: a group's name would pull the golang digest pins out of the Pin Dependencies pull request",
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "groupName": "go toolchain"
    },
    {
      "description": "vulnwatch's own image in the chart: the tag follows appVersion (empty) and releases set it, so no pinning (it would render vulnwatch:@sha256:...) and no updates",
      "matchManagers": ["helm-values"],
      "matchDepNames": ["ghcr.io/vasops/vulnwatch"],
      "enabled": false
    },
    {
      "description": "Kubernetes client libraries move together",
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes client"
    }
  ],
  "customManagers": [
    {
      "description": "Go tools run with go run pkg@version in the Makefile",
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "go run (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v[0-9][^\\s\"]*)"
      ],
      "datasourceTemplate": "go"
    }
  ]
}
